# Secrets des fonctions serveur. En production : supabase secrets set --env-file supabase/functions/.env
# Ne jamais mettre ce fichier rempli dans git ni dans une conversation.
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY et SUPABASE_ANON_KEY sont fournis automatiquement par Supabase.

# Site web Neeg Loc (pages retour.html et simulateur.html)
APP_URL=https://neegloc.sn
APP_ORIGIN=https://neegloc.sn

# Moyens proposés aux clients, séparés par des virgules :
#   wave, orange_money (API, comptes marchands), transfert_wave, transfert_om (transfert manuel), simulateur
MOYENS_ACTIFS=transfert_wave,transfert_om,simulateur

# ---- Transfert manuel (tests avec comptes personnels) ----
# Numéros qui reçoivent les transferts ; le gestionnaire valide chaque transfert après vérification
TRANSFERT_WAVE_NUMERO=
TRANSFERT_WAVE_NOM=
TRANSFERT_OM_NUMERO=
TRANSFERT_OM_NOM=
# Délai laissé au locataire pour envoyer et déclarer le transfert
TRANSFERT_DELAI_MINUTES=30

# ---- Wave Business (Business Portal > Développeur) ----
WAVE_API_KEY=
# Si la clé API a été créée avec « request signing » (secret wave_sn_AKS_...)
WAVE_SIGNING_SECRET=
# Secret du webhook (wave_sn_WHS_...) ; mode « signing » recommandé, « shared » possible
WAVE_WEBHOOK_SECRET=
WAVE_WEBHOOK_MODE=signing

# ---- Orange Money Sénégal (Sonatel) : compte développeur sur developer.orange-sonatel.com ----
# Sandbox : https://api.sandbox.orange-sonatel.com (par défaut) · production : https://api.orange-sonatel.com
ORANGE_BASE_URL=https://api.sandbox.orange-sonatel.com
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
# Code marchand Orange Money (6 chiffres)
ORANGE_MERCHANT_CODE=
ORANGE_MERCHANT_NAME=Neeg Loc
# Jeton secret ajouté à l'URL de rappel envoyée à Orange avec chaque QR code (…/webhook-orange?token=…)
ORANGE_CALLBACK_TOKEN=
# Passer à true après un paiement de test réussi en sandbox
ORANGE_MAPPING_VALIDE=false

# ---- Simulateur d'opérateur (tests sans compte marchand) ----
SIMULATEUR_ACTIF=true
SIMULATEUR_WEBHOOK_SECRET=change-moi-simulateur

# ---- Tâches ----
# Secret pour appeler paiements-maintenance depuis pg_cron / pg_net
CRON_SECRET=change-moi-cron
# true : les versements (caution, loyers, remboursements) partent automatiquement via Wave
PAYOUT_AUTO=false
